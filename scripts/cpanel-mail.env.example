# Copy to /root/.cpanel-mail.env and chmod 600
# node /opt/autorental/scripts/setup-cpanel-mail.mjs

DOMAIN=autotorental.com

# --- cPanel API (cPanel → Security → Manage API Tokens) ---
CPANEL_HOST=your-server.hostinger.com
CPANEL_USER=your_cpanel_username
CPANEL_API_TOKEN=your_cpanel_api_token

# --- Cloudflare API (My Profile → API Tokens → Edit zone DNS) ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id_for_autotorental_com

# --- Mail server (from cPanel → Connect Devices) ---
MAIL_SERVER_IP=YOUR_CPANEL_SERVER_IP
MX_HOST=mail.autotorental.com
MX_PRIORITY=10
SMTP_HOST=mail.autotorental.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@autotorental.com
SMTP_FROM=Auto to Rental <info@autotorental.com>

# Mailboxes to create (comma-separated)
MAILBOXES=info@autotorental.com,admin@autotorental.com,noreply@autotorental.com
MAIL_QUOTA_MB=1024
MAIL_DEFAULT_PASSWORD=change-me-strong-password
MAIL_PASS_INFO=password-for-info-account

# Optional
WEBMAIL_A=true
SPF_INCLUDE=
